# Supabase (Auth + optional Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars

# API
ConnectionStrings__Default=Host=localhost;Port=5432;Database=bonair_campaigns;Username=bonair;Password=bonair_dev_password
ConnectionStrings__Redis=localhost:6379
NEXT_PUBLIC_API_URL=http://localhost:8080
Cors__Origins=http://localhost:3000

# OpenAI
OPENAI_API_KEY=sk-your-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_AGENCY=price_...

# Storage (R2 / S3 compatible)
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bonair-assets

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Email
RESEND_API_KEY=
